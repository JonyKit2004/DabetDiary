<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/green"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="  " />

        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E0FFE0"
            android:padding="16dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:text="Новая запись"
                        android:textColor="#000000"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/meal_type_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/edit_text_background"
                        android:minHeight="48dp"
                        android:padding="10dp"
                        android:textColor="#000000"
                        android:textColorHint="@color/dark_gray"
                        android:spinnerMode="dropdown" />

                    <EditText
                        android:id="@+id/food_grams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:textColorHint="@color/dark_gray"
                        android:background="@drawable/edit_text_background"
                        android:hint="Сколько грамм пищи съедено"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:padding="10dp"
                        android:textColor="#000000" />

                    <EditText
                        android:id="@+id/carbs_per_100g"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Сколько углеводов на 100г"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp"
                        android:textColorHint="@color/dark_gray"
                        android:padding="10dp"
                        android:textColor="#000000" />

                    <EditText
                        android:id="@+id/carbs_per_unit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Сколько углеводов на 1 ХЕ"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp"
                        android:padding="10dp"
                        android:textColor="#000000"
                        android:textColorHint="@color/dark_gray" />

                    <EditText
                        android:id="@+id/blood_sugar_level"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Показатель сахара в крови"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp"
                        android:textColorHint="@color/dark_gray"
                        android:padding="10dp"
                        android:textColor="#000000" />

                    <Spinner
                        android:id="@+id/injection_type_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/edit_text_background"
                        android:minHeight="48dp"
                        android:padding="10dp"
                        android:textColorHint="@color/dark_gray"
                        android:textColor="#000000" />

                    <EditText
                        android:id="@+id/units_taken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Сколько единиц укола/таблеток принял"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:textColorHint="@color/dark_gray"
                        android:padding="10dp"
                        android:textColor="#000000" />

                    <EditText
                        android:id="@+id/comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/edit_text_background"
                        android:gravity="top"
                        android:hint="Комментарий: На завтрак я ел сегодня йогурт"
                        android:inputType="textMultiLine"
                        android:minHeight="100dp"
                        android:padding="10dp"
                        android:textColor="#000000"
                        android:textColorHint="@color/dark_gray" />

                    <Button
                        android:id="@+id/save_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/green"
                        android:gravity="center"
                        android:text="Сохранить запись"
                        android:textColor="@android:color/white"
                        app:iconPadding="8dp" />

                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#E0FFE0"
        app:headerLayout="@layout/nav_header" />

</androidx.drawerlayout.widget.DrawerLayout>